# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Immich Server Configuration
IMMICH_SERVER_HOST=your.server.com

# SSH Configuration (optional - use SSH config name instead of host/user)
IMMICH_SSH_CONFIG_NAME=your_ssh_config_entry_name

INBOX_DIR=./inbox
PROCESSED_DIR=./processed
OUTBOX_DIR=./outbox

# Open Alpha Link sequence manifests. Manifests pushed to `phototag receive` (.phototag/manifests)
# and inbox/*.json are always read; this adds more folders (comma list)
# SEQUENCE_MANIFEST_DIR=
PHOTOTAG_RECEIVE_PORT=8765
STACK_MAX_CLOCK_SKEW_SECONDS=120
